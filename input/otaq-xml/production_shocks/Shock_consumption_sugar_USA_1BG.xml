<?xml version="1.0" encoding="UTF-8"?>
<scenario>
   <world>
	<region name="USA">

	  <!-- Sugarcane ethanol consumption: shock level (1 BG produced in Brazil) -->

         <policy-portfolio-standard name="Sugar-Ethanol-Consumption-Floor">
            <policyType>subsidy</policyType>
            <market>USA</market>
            <min-price year="2020" fillout="1">-100</min-price>
            <constraint year="2020">0.008</constraint>
            <constraint year="2025">0.088</constraint>
            <constraint year="2030">0.088</constraint>
            <constraint year="2035">0.088</constraint>
            <constraint year="2040">0.088</constraint>
            <constraint year="2045">0.088</constraint>
            <constraint year="2050">0.088</constraint>
            <constraint year="2055">0.088</constraint>
            <constraint year="2060">0.088</constraint>
         </policy-portfolio-standard>


	<!-- APPLY CONSUMPTION FLOORS -->

 
         <supplysector name="refined liquids gasoline pool">
            <subsector name="ethanol">
               <technology name="sugar cane ethanol">
                   <period year="2020">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
                   <period year="2025">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
                   <period year="2030">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
                   <period year="2035">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
                   <period year="2040">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
                   <period year="2045">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
                   <period year="2050">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
                   <period year="2055">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
                   <period year="2060">
                       <input-subsidy name="Sugar-Ethanol-Consumption-Floor"/>
                   </period>
               </technology>
           </subsector>
         </supplysector>

      </region>

   </world>
</scenario>
